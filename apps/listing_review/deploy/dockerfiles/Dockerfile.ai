FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /work

# Install only this role's pinned dependencies.
COPY apps/listing_review/requirements/base.txt /tmp/requirements/base.txt
COPY apps/listing_review/requirements/ai.txt /tmp/requirements/ai.txt
RUN pip install --no-cache-dir -r /tmp/requirements/base.txt -r /tmp/requirements/ai.txt

# Install the course libraries without adding other dependencies.
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# Copy the entry points used by this image.
COPY apps/listing_review/jobs/prompt_eng/ ./apps/listing_review/jobs/prompt_eng/
COPY apps/listing_review/resources/ ./apps/listing_review/resources/
