AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
S10_POLL_SECONDS=15
# Local defaults work without setting paths. Compose supplies container paths.
# Run from the repository root, or set S10_ROOT in the process environment before Python starts.
# S10_MODEL=/absolute/path/to/a/trusted/model/bundle

# S10_PROMPTS=/absolute/path/to/an/active/prompt/bundle

# Docker Desktop address of the separately deployed upstream system.
S10_UPSTREAM_URL=http://host.docker.internal:8001
