# Copy to .env at the repository root. Enter keys locally; never share this file with keys.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Only the selected chat provider needs a key. Embeddings run locally.
GOOGLE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# Required for S8 notebooks 04 and 05.
TAVILY_API_KEY=

# Local artifact recording only.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# S9: optional role overrides; omit to use AI_PROVIDER and AI_MODEL.
# S9_JUDGE_PROVIDER=gemini
# S9_JUDGE_MODEL=gemini-2.5-flash
# S9_SYNTHETIC_PROVIDER=gemini
# S9_SYNTHETIC_MODEL=gemini-2.5-flash
